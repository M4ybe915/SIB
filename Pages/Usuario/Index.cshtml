@page
@model sistema_de_informacion_bibliotecaria_sib.Pages.Usuario.IndexModel

<h2>Usuarios</h2>



<a href="/Usuario/Create" class="btn btn-success mb-3">Agregar Usuario</a>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Nombre Completo</th>
            <th>Correo Electrónico</th>
            <th>Teléfono</th>
            <th>Carnet</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Usuarios)
        {
            <tr>
                <td>@u.IdUsuario</td>
                <td>@u.Nombre @u.Apellido</td>
                <td>@u.Correo</td>
                <td>@u.Telefono</td>
                <td>@u.Carnet</td>
                <td>
                    <a href="/Usuario/Edit?id=@u.IdUsuario" class="btn btn-warning btn-sm">Editar</a>
                    <a href="/Usuario/Eliminar?id=@u.IdUsuario" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

