@page
@model sistema_de_informacion_bibliotecaria_sib.Pages.Usuario.CreateModel

<h2>Nuevo Usuario</h2>

<form method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Usuario.Nombre" class="form-control" />
        <span asp-validation-for="Usuario.Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Apellido</label>
        <input asp-for="Usuario.Apellido" class="form-control" />
        <span asp-validation-for="Usuario.Apellido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Correo Electrónico</label>
        <input asp-for="Usuario.Correo" class="form-control" type="email" />
        <span asp-validation-for="Usuario.Correo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Teléfono</label>
        <input asp-for="Usuario.Telefono" class="form-control" />
        <span asp-validation-for="Usuario.Telefono" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Carnet</label>
        <input asp-for="Usuario.Carnet" class="form-control" />
        <span asp-validation-for="Usuario.Carnet" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Guardar</button>

</form>