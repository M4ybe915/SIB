<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Biblioteca SIB</title>


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>
<body>


    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-page="/Index">
                    📘 Biblioteca SIB
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house-door"></i> Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Libros">
                                <i class="bi bi-book"></i> Libros
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Usuario">
                                <i class="bi bi-people"></i> Usuarios
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Prestamo">
                                <i class="bi bi-arrow-left-right"></i> Préstamos
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <main role="main" class="pb-5">
        <div class="container mt-4">
            @RenderBody()
        </div>
    </main>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>