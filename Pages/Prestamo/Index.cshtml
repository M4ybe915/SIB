@page
@model sistema_de_informacion_bibliotecaria_sib.Pages.Prestamo.IndexModel

<h2>📚 Préstamos</h2>

<a asp-page="/Prestamo/Create" class="btn btn-primary mb-3">
    Nuevo Préstamo
</a>

<div class="table-responsive">

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-light">

            <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha Préstamo</th>
                <th>Estado</th>
                <th>Días Retraso</th>
                <th>Multa</th>
                <th>Acción</th>
                <th>Fecha Límite</th>
                <th>Fecha Devolución</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var p in Model.Lista)
            {
                bool devuelto = p.fechadevolucion.HasValue;

                bool retrasado =
                !devuelto &&
                p.FechaLimite.HasValue &&
                DateTime.Today > p.FechaLimite.Value;

                int diasRetraso =
                retrasado
                ? (DateTime.Today - p.FechaLimite.Value).Days
                : 0;

                decimal multaPorDia = 0.25m;
                decimal multa = diasRetraso * multaPorDia;



                <tr class="@(retrasado ? "table-danger" : "")">

                    <td>@p.IdPrestamo</td>

                    <td>@p.Usuario</td>

                    <td>@p.Libro</td>

                    <td>
                        @p.FechaPrestamo.ToString("dd/MM/yyyy")
                    </td>

                    <td>

                        @if (devuelto)
                        {
                            <span class="badge bg-success">
                                Devuelto
                            </span>
                        }
                        else if (retrasado)
                        {
                            <span class="badge bg-danger">
                                Retrasado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Activo
                            </span>
                        }

                    </td>

                    <td>

                        @if (retrasado)
                        {
                            <span class="fw-bold text-danger">
                                @diasRetraso día(s)
                            </span>
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </td>

                    <td>

                        @if (multa > 0)
                        {
                            <span class="fw-bold text-danger">
                                $@multa.ToString("0.00")
                            </span>
                        }
                        else
                        {
                            <span class="text-success">
                                $0.00
                            </span>
                        }

                    </td>

                    <td>

                        @if (!devuelto)
                        {
                            <a asp-page="/Prestamo/Devolver"
                               asp-route-id="@p.IdPrestamo"
                               class="btn btn-success btn-sm"
                               onclick="return confirm('¿Confirmar devolución?');">
                                Devolver
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Completado
                            </span>
                        }

                    </td>

                    <td>

                        @(p.FechaLimite.HasValue
                                            ? p.FechaLimite.Value.ToString("dd/MM/yyyy")
                                            : "-")

                    </td>

                    <td>

                        @(p.fechadevolucion.HasValue
                                            ? p.fechadevolucion.Value.ToString("dd/MM/yyyy")
                                            : "-")

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
