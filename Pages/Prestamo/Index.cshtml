@page
@model sistema_de_informacion_bibliotecaria_sib.Pages.Prestamo.IndexModel

<h2>📚 Préstamos</h2>

<a asp-page="/Prestamo/Create" class="btn btn-primary mb-3">
    Nuevo Préstamo
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Usuario</th>
            <th>Libro</th>
            <th>Préstamo</th>
            <th>Estado</th>
            <th>Acción</th>
            <th>Fecha Límite</th>
            <th>Fecha Devolución</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model.Lista)
        {
            <tr>

                <td>@p.IdPrestamo</td>

                <td>@p.Usuario</td>

                <td>@p.Libro</td>

                <td>@p.FechaPrestamo.ToShortDateString()</td>

                <td>
                    @if (!string.IsNullOrEmpty(p.Estado) &&
                                    p.Estado.ToLower().Trim() == "devuelto")
                    {
                        <span class="badge bg-success">
                            Devuelto
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Activo
                        </span>
                    }
                </td>

                <td>
                    @if (string.IsNullOrEmpty(p.Estado) ||
                                    p.Estado.ToLower() != "devuelto")
                    {
                        <a asp-page="/Prestamo/Devolver"
                           asp-route-id="@p.IdPrestamo"
                           class="btn btn-success btn-sm"
                           onclick="return confirm('¿Confirmar devolución?');">
                            Devolver
                        </a>
                    }
            </td>

            <td>
                @(p.FechaLimite.HasValue
                                ? p.FechaLimite.Value.ToShortDateString()
                                : "-")
                                  </td>

            <td>
                @(p.fechadevolucion.HasValue
                                ? p.fechadevolucion.Value.ToShortDateString()
                                : "-")
            </td>

            </tr>
                }
    </tbody>
</table>