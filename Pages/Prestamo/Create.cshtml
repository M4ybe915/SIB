@page
@model sistema_de_informacion_bibliotecaria_sib.Pages.Prestamo.CreateModel

<h2 class="mb-4">📚 Nuevo Préstamo</h2>

<form method="post">

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <select asp-for="Prestamo.IdUsuario" class="form-control">
            <option value="">-- Seleccione un usuario --</option>
            @foreach (var u in Model.Usuarios)
            {
                <option value="@u.IdUsuario">@u.Nombre</option>
            }
        </select>
        <span asp-validation-for="Prestamo.IdUsuario" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Libro</label>
        <select asp-for="Prestamo.IdLibro" class="form-control">
            <option value="">-- Seleccione un libro --</option>
            @foreach (var l in Model.Libros)
            {
                <option value="@l.IdLibro">
                    @l.Titulo (Disponibles: @l.Cantidad)
                </option>
            }
        </select>
        <span asp-validation-for="Prestamo.IdLibro" class="text-danger"></span>
    </div>

    <div class="alert alert-info">
        📅 El préstamo se registrará con la fecha actual.<br />
        ⏳ La fecha límite será dentro de 7 días automáticamente.
    </div>

    <button class="btn btn-success">Registrar Préstamo</button>
    <a href="/Prestamo/Index" class="btn btn-secondary">Cancelar</a>
    <a href="/Prestamo/Index" class="btn btn-secondary">Devolver</a>

</form>