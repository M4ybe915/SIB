@page
@model IndexModel

@{
    ViewData["Title"] = "Biblioteca SIB";
}



<div class="container-fluid px-4 menu-container">
    <div class="row g-4">

        <div class="col-md-4">
            <a href="/Libros/Create" class="text-decoration-none">
                <div class="menu-box menu-green">
                    <div class="fs-1">📚</div>
                    <h4>Libros</h4>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a href="/Usuario/Create" class="text-decoration-none">
                <div class="menu-box menu-cyan">
                    <div class="fs-1">👤</div>
                    <h4>Usuarios</h4>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a href="/Prestamo/Create" class="text-decoration-none">
                <div class="menu-box menu-blue">
                    <div class="fs-1">🔄</div>
                    <h4>Préstamos</h4>
                </div>
            </a>
        </div>

    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="container-fluid px-4 mt-4">
        <div class="alert alert-success shadow-sm rounded-4 border-0">
            ✅ @Model.Mensaje
        </div>
    </div>
}


<div class="container-fluid px-4 mt-4 mb-5">
    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0 fw-bold">
                    📖 Libros Registrados
                </h3>

                <a href="/Libros/Create" class="btn btn-light">
                    ➕ Agregar Libro
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Cantidad</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var libro in Model.Libros)
                        {
                            <tr>
                                <td>@libro.IdLibro</td>
                                <td class="fw-semibold">@libro.Titulo</td>
                                <td>@libro.Autor</td>
                                <td>@libro.Cantidad</td>

                                <td class="text-center">
                                    @if (libro.Cantidad > 0)
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            Disponible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2">
                                            Agotado
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

    </div>
</div>
