@page
@model IndexModel

@{
    ViewData["Title"] = "Biblioteca SIB";
}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
    <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="/">
            📘 Biblioteca SIB
        </a>
        <div>
            <a class="nav-link d-inline text-white me-4 fw-semibold" href="/Libros">
                📚 Libros
            </a>
            <a class="nav-link d-inline text-white me-4 fw-semibold" href="/Usuario">
                👤 Usuarios
            </a>
            <a class="nav-link d-inline text-white fw-semibold" href="/Prestamo">
                🔄 Prestamos
            </a>
        </div>
    </div>
</nav>
<div class="container mt-5">
    <div class="text-center mb-5">

        <h1 class="display-3 fw-bold text-primary">
            Bienvenido a Biblioteca SIB
        </h1>

       
        </div>

        <hr class="w-50 mx-auto mt-5" />

    </div>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <a href="/Libros/Create" class="text-decoration-none">
                <div class="card shadow-lg border-0 rounded-4 h-100 p-4 text-center card-hover">
                    <div class="fs-1 mb-3">📚</div>
                    <h3 class="fw-bold text-primary"></h3>
                    <p class="text-muted">
                        Gestión completa del catálogo bibliográfico
                    </p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Usuario/Create" class="text-decoration-none">
                <div class="card shadow-lg border-0 rounded-4 h-100 p-4 text-center card-hover">
                    <div class="fs-1 mb-3">👤</div>
                    <h3 class="fw-bold text-primary">Usuarios</h3>
                    <p class="text-muted">
                        Registro y administración de lectores
                    </p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Prestamo/Create" class="text-decoration-none">
                <div class="card shadow-lg border-0 rounded-4 h-100 p-4 text-center card-hover">
                    <div class="fs-1 mb-3">🔄</div>
                    <h3 class="fw-bold text-primary">Prestamos</h3>
                    <p class="text-muted">
                        Control de préstamos y devoluciones
                    </p>
                </div>
            </a>
        </div>

    </div>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success shadow-sm rounded-4 border-0 mb-5">
            ✅ @Model.Mensaje
        </div>
    }
    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white p-4 rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">

                <h3 class="mb-0 fw-bold">
                    📖 Libros Registrados
                </h3>

                <a href="/Libros/Create" class="btn btn-light">
                    ➕ Agregar Libro
                </a>

            </div>
        </div>

        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Cantidad</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var libro in Model.Libros)
                        {
                            <tr>
                                <td>@libro.IdLibro</td>
                                <td class="fw-semibold">@libro.Titulo</td>
                                <td>@libro.Autor</td>
                                <td>@libro.Cantidad</td>

                                <td class="text-center">
                                    <span class="badge bg-success px-3 py-2">
                                        Disponible
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
<footer class="text-center p-4 mt-5 border-top text-muted">
    © 2026 Biblioteca SIB | Proyecto Universitario
</footer>
<style>
    .card-hover {
        transition: 0.3s;
    }

        .card-hover:hover {
            transform: translateY(-8px);
        }
</style>